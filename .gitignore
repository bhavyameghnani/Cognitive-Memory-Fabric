node_modules/
ui/**/node_modules/
ui/**/dist/
npm-debug.log*

# Local Claude Code settings
.claude/settings.local.json

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.log
