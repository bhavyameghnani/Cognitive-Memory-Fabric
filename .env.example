# PRODUCTION-SAFE defaults.  Copy to .env (git-ignored) and fill in.  Real environment variables always override this file.
# For LOCAL DEVELOPMENT with the browser UI copy .env.development.example instead (it explicitly selects the development profile).

# --- LLM backend: openai | ollama | mock ---
CMF_LLM_BACKEND=openai

# --- OpenAI ---
OPENAI_API_KEY=
CMF_OPENAI_MODEL=gpt-4o-mini
CMF_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (Qwen) ---
CMF_LLM_BASE_URL=http://localhost:11434
CMF_LLM_MODEL=qwen2.5:3b
CMF_LLM_NUM_CTX=6144

# --- Shared generation settings ---
CMF_LLM_TEMPERATURE=0
CMF_LLM_MAX_TOKENS=1500
CMF_LLM_TIMEOUT=120

# --- Databases (paths are relative to the repo root; run the CLI from there with PYTHONPATH=src) ---
CMF_DATABASE_URL=sqlite:///build/cmf_ops_smoke.db
CMF_MEMORY_DATABASE_URL=sqlite:///build/cmf_memory.db

# --- Tool server session allow-list (comma separated client ids; empty = all) ---
CMF_ALLOWED_CLIENTS=

# --- Backend API (api/main.py; run with: PYTHONPATH=src .venv/bin/python -m api.main) ---
CMF_API_HOST=127.0.0.1
CMF_API_PORT=8000
# Origins allowed to call the API directly from a browser (comma separated). Not needed when the UI uses the Vite proxy.
CMF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (ui/cmf-brain-ui reads ONLY VITE_* variables from this same file) ---
VITE_DEV_PORT=5173
# Where the dev server forwards /api. Keep in sync with CMF_API_HOST/PORT.
VITE_API_PROXY_TARGET=http://localhost:8000
# Absolute API URL for a deployed UI (needs CMF_CORS_ORIGINS to include the UI origin). Leave empty in development.
VITE_API_BASE_URL=

# --- Harness (src/harness): budgets, governance, observability.  See docs/harness.md ---
# production (the default, stated explicitly here): every safety control is always on and the API serves NOTHING but /api/health without a verified identity.
HARNESS_PROFILE=production

# --- Identity (the HTTP API) ---
# Identity is a SIGNED Bearer token (HS256 JWT) minted by whatever authenticates people in front of CMF.  X-CMF-Actor-* headers are never authentication.
# Token claims: sub (actor id), role (advisor | supervisor | admin | operator | service), exp (unix seconds).  Mint a test token with:
#     PYTHONPATH=src python -m harness.auth_tokens --actor ADVISOR-001 --role advisor
# Set a random secret of at least 32 characters (for example: python -c "import secrets; print(secrets.token_urlsafe(48))") and keep it out of version control.
# Leaving it empty is safe but useless for the API: every protected route answers 401.  With CMF_AUTH_TRUSTED_GATEWAY=true the API REFUSES TO START without it.
CMF_AUTH_JWT_SECRET=
CMF_AUTH_TRUSTED_GATEWAY=false
# Optional: require these claims in every token.
CMF_AUTH_ISSUER=
CMF_AUTH_AUDIENCE=
# /docs and /openapi.json are OFF in production; true serves them only to callers presenting a verified token.
CMF_API_DOCS_ENABLED=false
# Note: the bundled browser UI does not send tokens, so against a production API it needs a gateway that adds the Authorization header.
HARNESS_ENABLED=true
HARNESS_MAX_LLM_CALLS=20
HARNESS_MAX_RETRIES=6
HARNESS_MAX_RETRIES_PER_OPERATION=2
HARNESS_MAX_TOOL_CALLS=12
HARNESS_MAX_RUNTIME_SECONDS=600
HARNESS_MAX_INPUT_TOKENS=60000
HARNESS_MAX_OUTPUT_TOKENS=10000
HARNESS_MAX_TOTAL_TOKENS=70000
HARNESS_MAX_CONTEXT_TOKENS=6144
HARNESS_COMPRESSION_ENABLED=true
HARNESS_CACHE_ENABLED=true
HARNESS_CACHE_TTL_SECONDS=900
HARNESS_EVIDENCE_VERIFICATION=true
# Structured claim verification (exact value/unit/polarity/period/modality); cannot be switched off in the production profile.
HARNESS_STRUCTURED_CLAIM_VERIFICATION=true
HARNESS_TEMPORAL_CONFLICT_DETECTION=true
HARNESS_PERMISSION_GATE=true
HARNESS_MEMORY_WRITE_VALIDATION=true
HARNESS_APPROVAL_REQUIRED_FOR_HIGH_RISK=true
# Semantic memory topics whose durable change needs a human decision (comma separated, empty = none), e.g. risk_tolerance
# Human approvals are stored in SQLite and survive restarts; an approval is valid this many seconds (60..2592000) and releases its answer once, to the requester.
HARNESS_APPROVAL_TTL_SECONDS=14400
# Compress-and-retry attempts after the model provider rejects a prompt as too long (0 disables; max 3; also capped by HARNESS_MAX_RETRIES_PER_OPERATION).
HARNESS_MAX_CONTEXT_RECOVERIES=1
# PROCESS-WIDE caps (all requests, both transports). A worker keeps its slot until the provider call has really exited.
HARNESS_MAX_PROVIDER_WORKERS=32
HARNESS_MAX_ABANDONED_WORKERS=8
# Best-effort cancel_call threads (never awaited by the request) and how long one may run before it is reported as timed out.
HARNESS_MAX_CANCEL_WORKERS=4
HARNESS_CANCEL_TIMEOUT_SECONDS=2
# CMF_APPROVAL_DATABASE_URL=sqlite:///build/cmf_approvals.db
HARNESS_APPROVAL_SENSITIVE_MEMORY_TOPICS=
HARNESS_TRACE_ENABLED=true
HARNESS_TRACE_RETENTION_DAYS=30
HARNESS_STRANDS_EXECUTION=true
HARNESS_EVALUATION_ENABLED=true
